{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["tests/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noUselessLoneBlockStatements": "off"
					}
				}
			}
		}
	]
}
