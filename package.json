{
  "name": "@roodriigoooo/pi-hunk",
  "version": "1.0.0",
  "description": "One-command Hunk review handoff for Pi: /hunk opens a Hunk review and forwards its human notes to the agent when it closes.",
  "type": "module",
  "license": "MIT",
  "author": "rosastre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roodriigoooo/pi-hunk.git"
  },
  "homepage": "https://github.com/roodriigoooo/pi-hunk",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node scripts/units.mjs && node scripts/smoke.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "hunk",
    "code-review",
    "human-in-the-loop"
  ]
}
